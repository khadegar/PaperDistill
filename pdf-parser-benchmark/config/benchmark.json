    "preflight_duration_seconds": 30,
    "preflight_interval_seconds": 5,
    "monitor_interval_seconds": 2,
    "maximum_average_gpu_utilization_percent": 5,
    "minimum_free_vram_mib": 75000,
    "cpu_threads": 8,
    "per_document_timeout_seconds": 900
